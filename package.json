{
  "name": "medicitas",
  "version": "0.1.0",
  "private": true,
  "description": "MediCitas: plataforma SaaS multi-tenant de citas médicas",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"packages/*/test/**/*.test.js\" \"services/*/test/**/*.test.js\" \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"packages/*/test/**/*.test.js\" \"services/*/test/**/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"tests/**/*.test.js\""
  }
}
