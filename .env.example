# Copiar a .env antes de levantar:  cp .env.example .env
# Valores solo para desarrollo local. El .env real no se sube al repositorio.

# --- PostgreSQL ---
# Superusuario: solo lo usa la imagen para inicializar el contenedor.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# Dueño del esquema (mc_owner) y usuario de conexión del backend (mc_app).
DB_OWNER_PASSWORD=mc_owner_dev
DB_APP_PASSWORD=mc_app_dev

# Puerto publicado en esta máquina (dentro de la red de Compose siempre es 5432).
DB_PORT=5432

# --- Keycloak ---
KEYCLOAK_DB_PASSWORD=keycloak_dev
# Usuario administrador de la consola (http://localhost:8080).

# Los usuarios de prueba del realm "medicitas" están en keycloak/medicitas-realm.json.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
KEYCLOAK_PORT=8080

# --- Redis (caché de disponibilidad) ---
REDIS_PASSWORD=redis_dev

# --- API ---
APP_PORT=3000
